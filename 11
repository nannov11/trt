<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kartu Tarot Hari Ini</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --color-background-primary: #ffffff;
    --color-background-secondary: #f5f4f0;
    --color-background-tertiary: #eeecea;
    --color-text-primary: #1a1a18;
    --color-text-secondary: #6b6966;
    --color-border-tertiary: rgba(0,0,0,0.12);
    --color-border-secondary: rgba(0,0,0,0.22);
    --border-radius-md: 8px;
    --border-radius-lg: 12px;
    --border-radius-xl: 16px;
    --font-sans: system-ui, -apple-system, sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-background-primary: #1e1e1c;
      --color-background-secondary: #2a2a28;
      --color-background-tertiary: #141412;
      --color-text-primary: #f0ede8;
      --color-text-secondary: #999690;
      --color-border-tertiary: rgba(255,255,255,0.1);
      --color-border-secondary: rgba(255,255,255,0.2);
    }
  }

  body {
    background: var(--color-background-tertiary);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .tarot-app {
    width: 100%;
    max-width: 520px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .title {
    font-size: 22px;
    font-weight: 500;
    color: var(--color-text-primary);
    letter-spacing: 0.05em;
    text-align: center;
  }

  .subtitle {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin-top: -0.75rem;
  }

  .datetime-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .datetime-time {
    font-size: 18px;
    font-weight: 500;
    color: var(--color-text-primary);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .datetime-date {
    font-size: 13px;
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
  }

  .wheel-wrapper {
    position: relative;
    width: 280px;
    height: 280px;
    flex-shrink: 0;
  }

  #wheelCanvas { width: 280px; height: 280px; }

  .spin-btn {
    padding: 0.65rem 2.5rem;
    font-size: 15px;
    font-weight: 500;
    background: var(--color-background-primary);
    color: var(--color-text-primary);
    border: 0.5px solid var(--color-border-secondary);
    border-radius: var(--border-radius-lg);
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
  }

  .spin-btn:hover { background: var(--color-background-secondary); }
  .spin-btn:active { transform: scale(0.97); }
  .spin-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .card-reveal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .card-reveal.visible { display: flex; animation: overlayIn 0.3s ease; }

  @keyframes overlayIn { from { opacity: 0; } to { opacity: 1; } }

  .card-modal {
    background: var(--color-background-primary);
    border-radius: var(--border-radius-xl);
    border: 0.5px solid var(--color-border-tertiary);
    padding: 1.5rem;
    width: 100%;
    max-width: 380px;
    animation: modalIn 0.35s cubic-bezier(0.34,1.56,0.64,1);
  }

  @keyframes modalIn { from { opacity: 0; transform: scale(0.85) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }

  .card-header {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 1rem;
  }

  .card-icon {
    width: 52px;
    height: 72px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    flex-shrink: 0;
    border: 0.5px solid var(--color-border-tertiary);
  }

  .card-meta { flex: 1; }

  .card-name {
    font-size: 18px;
    font-weight: 500;
    color: var(--color-text-primary);
    margin-bottom: 3px;
  }

  .card-type {
    font-size: 12px;
    font-weight: 500;
    padding: 2px 10px;
    border-radius: var(--border-radius-md);
    display: inline-block;
    margin-bottom: 6px;
  }

  .type-major     { background: #EEEDFE; color: #3C3489; }
  .type-wands     { background: #FAEEDA; color: #633806; }
  .type-cups      { background: #E6F1FB; color: #0C447C; }
  .type-swords    { background: #F1EFE8; color: #444441; }
  .type-pentacles { background: #EAF3DE; color: #27500A; }

  .card-number {
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .divider {
    height: 0.5px;
    background: var(--color-border-tertiary);
    margin: 0.75rem 0;
  }

  .card-meaning-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: 4px;
  }

  .card-meaning {
    font-size: 14px;
    color: var(--color-text-primary);
    line-height: 1.6;
  }

  .card-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .keyword {
    font-size: 12px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--color-background-secondary);
    color: var(--color-text-secondary);
    border: 0.5px solid var(--color-border-tertiary);
  }

  .pointer {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 18px;
    height: 18px;
    background: var(--color-text-primary);
    border-radius: 50%;
    z-index: 10;
    border: 3px solid var(--color-background-primary);
  }

  .needle {
    position: absolute;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 10px solid transparent;
    border-right: 10px solid transparent;
    border-top: 26px solid var(--color-text-primary);
    z-index: 10;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.2));
  }

  .intro-overlay {
    display: flex;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 200;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    animation: overlayIn 0.3s ease;
  }

  .intro-overlay.hidden { display: none; }

  .intro-modal {
    background: var(--color-background-primary);
    border-radius: var(--border-radius-xl);
    border: 0.5px solid var(--color-border-tertiary);
    padding: 2rem 1.75rem;
    width: 100%;
    max-width: 360px;
    animation: modalIn 0.35s cubic-bezier(0.34,1.56,0.64,1);
  }

  .intro-title {
    font-size: 18px;
    font-weight: 500;
    color: var(--color-text-primary);
    margin-bottom: 4px;
  }

  .intro-subtitle {
    font-size: 13px;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .intro-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: 6px;
  }

  .intro-input {
    width: 100%;
    padding: 0.6rem 0.85rem;
    font-size: 15px;
    font-family: var(--font-sans);
    background: var(--color-background-secondary);
    color: var(--color-text-primary);
    border: 0.5px solid var(--color-border-secondary);
    border-radius: var(--border-radius-md);
    outline: none;
    margin-bottom: 1.25rem;
    transition: border-color 0.15s;
  }

  .intro-input:focus { border-color: var(--color-text-secondary); }

  .mood-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 1.5rem;
  }

  .mood-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 10px 4px 8px;
    border-radius: var(--border-radius-md);
    border: 0.5px solid var(--color-border-tertiary);
    background: var(--color-background-secondary);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, transform 0.1s;
  }

  .mood-btn:hover { background: var(--color-background-tertiary); }
  .mood-btn:active { transform: scale(0.95); }

  .mood-btn.selected {
    border-color: var(--color-border-primary);
    background: var(--color-background-primary);
    border-width: 1.5px;
    box-shadow: 0 0 0 2px rgba(0,0,0,0.08);
  }

  .mood-emoji { font-size: 22px; line-height: 1; }
  .mood-label { font-size: 10px; color: var(--color-text-secondary); text-align: center; }

  .intro-start-btn {
    width: 100%;
    padding: 0.7rem;
    font-size: 15px;
    font-weight: 500;
    background: var(--color-text-primary);
    color: var(--color-background-primary);
    border: none;
    border-radius: var(--border-radius-lg);
    cursor: pointer;
    transition: opacity 0.15s, transform 0.1s;
  }

  .intro-start-btn:hover { opacity: 0.85; }
  .intro-start-btn:active { transform: scale(0.98); }
  .intro-start-btn:disabled { opacity: 0.3; cursor: not-allowed; }
</style>
</head>
<body>
<div class="intro-overlay" id="introOverlay">
  <div class="intro-modal">
    <div class="intro-title">Hai, Beautiful Soul ✨</div>
    <p class="intro-subtitle">Bolehkah aku tau namamu dan apa yang sedang kamu rasakan?</p>

    <div class="intro-label">Nama kamu</div>
    <input class="intro-input" id="nameInput" type="text" placeholder="Tulis namamu di sini..." maxlength="30" oninput="checkIntroReady()" />

    <div class="intro-label" style="margin-bottom:8px;">Mood hari ini</div>
    <div class="mood-grid" id="moodGrid">
      <button class="mood-btn" onclick="selectMood(this,'😊','Bahagia')"><span class="mood-emoji">😊</span><span class="mood-label">Bahagia</span></button>
      <button class="mood-btn" onclick="selectMood(this,'😔','Sedih')"><span class="mood-emoji">😔</span><span class="mood-label">Sedih</span></button>
      <button class="mood-btn" onclick="selectMood(this,'😤','Kesal')"><span class="mood-emoji">😤</span><span class="mood-label">Kesal</span></button>
      <button class="mood-btn" onclick="selectMood(this,'😰','Cemas')"><span class="mood-emoji">😰</span><span class="mood-label">Cemas</span></button>
      <button class="mood-btn" onclick="selectMood(this,'🥰','Jatuh Cinta')"><span class="mood-emoji">🥰</span><span class="mood-label">Jatuh Cinta</span></button>
      <button class="mood-btn" onclick="selectMood(this,'😴','Lelah')"><span class="mood-emoji">😴</span><span class="mood-label">Lelah</span></button>
      <button class="mood-btn" onclick="selectMood(this,'🤩','Semangat')"><span class="mood-emoji">🤩</span><span class="mood-label">Semangat</span></button>
      <button class="mood-btn" onclick="selectMood(this,'🫠','Bingung')"><span class="mood-emoji">🫠</span><span class="mood-label">Bingung</span></button>
      <button class="mood-btn" onclick="selectMood(this,'😌','Tenang')"><span class="mood-emoji">😌</span><span class="mood-label">Tenang</span></button>
      <button class="mood-btn" onclick="selectMood(this,'🥺','Rindu')"><span class="mood-emoji">🥺</span><span class="mood-label">Rindu</span></button>
      <button class="mood-btn" onclick="selectMood(this,'😎','Percaya Diri')"><span class="mood-emoji">😎</span><span class="mood-label">PD</span></button>
      <button class="mood-btn" onclick="selectMood(this,'🤯','Overwhelmed')"><span class="mood-emoji">🤯</span><span class="mood-label">Overwhelmed</span></button>
    </div>

    <button class="intro-start-btn" id="startBtn" disabled onclick="startApp()">Mulai Perjalanan →</button>
  </div>
</div>

<div class="tarot-app">
  <div class="title" id="mainTitle">Kartu Tarot Hari Ini</div>
  <div class="datetime-box">
    <div class="datetime-date" id="dateDisplay"></div>
    <div class="datetime-time" id="clock"></div>
  </div>
  <p class="subtitle">Putar roda untuk menarik kartumu</p>

  <div class="wheel-wrapper">
    <canvas id="wheelCanvas" width="560" height="560"></canvas>
    <div class="pointer"></div>
  </div>

  <button class="spin-btn" id="spinBtn" onclick="spinWheel()">Pilih Kartumu</button>
</div>

<div style="position: fixed; bottom: 12px; left: 0; right: 0; text-align: center; font-size: 11px; color: var(--color-text-secondary); opacity: 1; pointer-events: none; z-index: 999;">
  ✋🧙🏻@nannov11 · 2026
</div>

<div class="card-reveal" id="cardReveal">
  <div class="card-modal">
    <div style="font-size:12px; color:var(--color-text-secondary); margin-bottom:1rem; display:flex; justify-content:space-between; align-items:center;">
      <span id="modalName"></span>
      <span id="modalMood"></span>
    </div>
    <div class="card-header">
      <div class="card-icon" id="cardIcon"></div>
      <div class="card-meta">
        <div class="card-name" id="cardName"></div>
        <span class="card-type" id="cardType"></span>
        <div class="card-number" id="cardNumber"></div>
      </div>
    </div>
    <div class="divider"></div>
    <div class="card-meaning-label">Makna</div>
    <div class="card-meaning" id="cardMeaning"></div>
    <div class="card-keywords" id="cardKeywords"></div>
    <div style="margin-top: 1rem; padding: 0.65rem 0.85rem; background: var(--color-background-secondary); border-radius: var(--border-radius-md); border: 0.5px solid var(--color-border-tertiary);">
      <p style="font-size: 11.5px; color: var(--color-text-secondary); line-height: 1.6; font-style: italic;">*Kamu tetap butuh <em style="font-style:normal; color: var(--color-text-primary); font-weight:500;">'human tarot reader'</em> untuk interpretasi lengkap sesuai dengan konteks kejadian yang kamu alami.</p>
    </div>
    <div style="margin-top: 1rem;">
      <button class="spin-btn" style="width:100%; justify-content:center;" onclick="closeAndSpin()">Pilih Kartu Lagi</button>
    </div>
  </div>
</div>

<script>
let userName = '';
let userMood = '';

function selectMood(btn, emoji, label) {
  document.querySelectorAll('.mood-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
  userMood = emoji + ' ' + label;
  checkIntroReady();
}

function checkIntroReady() {
  const name = document.getElementById('nameInput').value.trim();
  document.getElementById('startBtn').disabled = !(name && userMood);
}

document.addEventListener('DOMContentLoaded', () => {
  const introModal = document.getElementById('introOverlay');
  let soundPlayed = false;
  function triggerSound() {
    if (!soundPlayed) { soundPlayed = true; playCauldronSound(); }
    introModal.removeEventListener('click', triggerSound);
    introModal.removeEventListener('keydown', triggerSound);
  }
  introModal.addEventListener('click', triggerSound);
  introModal.addEventListener('keydown', triggerSound);
});

function playCauldronSound() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();

    function bubble(startTime, freq, dur) {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      const bend = ctx.createOscillator();
      const bendGain = ctx.createGain();
      bend.connect(bendGain);
      bendGain.connect(osc.frequency);
      bendGain.gain.setValueAtTime(freq * 0.3, startTime);
      bendGain.gain.exponentialRampToValueAtTime(0.01, startTime + dur);
      bend.frequency.setValueAtTime(3 + Math.random() * 5, startTime);
      bend.start(startTime); bend.stop(startTime + dur);
      osc.connect(gain); gain.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, startTime);
      osc.frequency.exponentialRampToValueAtTime(freq * 1.8, startTime + dur * 0.6);
      osc.frequency.exponentialRampToValueAtTime(freq * 0.5, startTime + dur);
      gain.gain.setValueAtTime(0, startTime);
      gain.gain.linearRampToValueAtTime(0.12, startTime + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.001, startTime + dur);
      osc.start(startTime); osc.stop(startTime + dur);
    }

    function drip(startTime) {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(1800, startTime);
      osc.frequency.exponentialRampToValueAtTime(300, startTime + 0.18);
      gain.gain.setValueAtTime(0.09, startTime);
      gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.18);
      osc.start(startTime); osc.stop(startTime + 0.18);
    }

    function mysticalHum(startTime, duration) {
      const freqs = [80, 120, 160, 220];
      freqs.forEach(f => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        const lfo = ctx.createOscillator();
        const lfoGain = ctx.createGain();
        lfo.connect(lfoGain); lfoGain.connect(gain.gain);
        lfo.frequency.setValueAtTime(0.4 + Math.random(), startTime);
        lfoGain.gain.setValueAtTime(0.02, startTime);
        osc.connect(gain); gain.connect(ctx.destination);
        osc.type = 'sine';
        osc.frequency.setValueAtTime(f, startTime);
        gain.gain.setValueAtTime(0, startTime);
        gain.gain.linearRampToValueAtTime(0.04, startTime + 0.4);
        gain.gain.setValueAtTime(0.04, startTime + duration - 0.3);
        gain.gain.linearRampToValueAtTime(0, startTime + duration);
        lfo.start(startTime); lfo.stop(startTime + duration);
        osc.start(startTime); osc.stop(startTime + duration);
      });
    }

    function sparkle(startTime) {
      [1200,1800,2400,3200,4000].forEach((f, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination);
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(f, startTime + i * 0.06);
        gain.gain.setValueAtTime(0.07, startTime + i * 0.06);
        gain.gain.exponentialRampToValueAtTime(0.001, startTime + i * 0.06 + 0.25);
        osc.start(startTime + i * 0.06);
        osc.stop(startTime + i * 0.06 + 0.25);
      });
    }

    function whoosh(startTime) {
      const bufSize = ctx.sampleRate * 0.6;
      const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < bufSize; i++) data[i] = (Math.random() * 2 - 1);
      const noise = ctx.createBufferSource();
      noise.buffer = buf;
      const filter = ctx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.setValueAtTime(200, startTime);
      filter.frequency.exponentialRampToValueAtTime(1800, startTime + 0.3);
      filter.frequency.exponentialRampToValueAtTime(400, startTime + 0.6);
      filter.Q.setValueAtTime(3, startTime);
      const gain = ctx.createGain();
      gain.gain.setValueAtTime(0, startTime);
      gain.gain.linearRampToValueAtTime(0.15, startTime + 0.1);
      gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.6);
      noise.connect(filter); filter.connect(gain); gain.connect(ctx.destination);
      noise.start(startTime); noise.stop(startTime + 0.6);
    }

    mysticalHum(0, 3.5);
    whoosh(0.1);
    drip(0.3); drip(0.55); drip(0.75);
    bubble(0.4, 180, 0.4);
    bubble(0.65, 220, 0.35);
    bubble(0.9, 160, 0.45);
    bubble(1.1, 250, 0.3);
    drip(1.2); drip(1.45);
    bubble(1.3, 200, 0.4);
    bubble(1.55, 140, 0.5);
    whoosh(1.6);
    bubble(1.8, 280, 0.3);
    drip(1.9); drip(2.1);
    bubble(2.0, 190, 0.4);
    sparkle(2.3);
    bubble(2.5, 230, 0.3);
    drip(2.6);
    sparkle(2.9);
  } catch(e) {}
}

function playStartBubble() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();

    function bubble(t, freq, dur) {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, t);
      osc.frequency.exponentialRampToValueAtTime(freq * 2.2, t + dur * 0.5);
      osc.frequency.exponentialRampToValueAtTime(freq * 0.4, t + dur);
      gain.gain.setValueAtTime(0, t);
      gain.gain.linearRampToValueAtTime(0.15, t + 0.015);
      gain.gain.exponentialRampToValueAtTime(0.001, t + dur);
      osc.start(t); osc.stop(t + dur);
    }

    function glug(t) {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(400, t);
      osc.frequency.exponentialRampToValueAtTime(100, t + 0.22);
      gain.gain.setValueAtTime(0.18, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.22);
      osc.start(t); osc.stop(t + 0.22);
    }

    function pourWhoosh(t) {
      const buf = ctx.createBuffer(1, ctx.sampleRate * 0.5, ctx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
      const src = ctx.createBufferSource(); src.buffer = buf;
      const flt = ctx.createBiquadFilter(); flt.type = 'bandpass';
      flt.frequency.setValueAtTime(600, t);
      flt.frequency.linearRampToValueAtTime(1400, t + 0.25);
      flt.Q.value = 2;
      const gain = ctx.createGain();
      gain.gain.setValueAtTime(0, t);
      gain.gain.linearRampToValueAtTime(0.12, t + 0.08);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.5);
      src.connect(flt); flt.connect(gain); gain.connect(ctx.destination);
      src.start(t); src.stop(t + 0.5);
    }

    pourWhoosh(0);
    glug(0.1);
    bubble(0.15, 200, 0.3);
    bubble(0.28, 280, 0.28);
    glug(0.35);
    bubble(0.42, 160, 0.35);
    bubble(0.55, 240, 0.25);
    glug(0.6);
    bubble(0.68, 300, 0.22);
    [900,1200,1600,2100].forEach((f, i) => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.type = 'triangle';
      osc.frequency.value = f;
      gain.gain.setValueAtTime(0.06, 0.8 + i * 0.07);
      gain.gain.exponentialRampToValueAtTime(0.001, 0.8 + i * 0.07 + 0.2);
      osc.start(0.8 + i * 0.07); osc.stop(0.8 + i * 0.07 + 0.2);
    });
  } catch(e) {}
}

function playSpinBubble() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();

    function bubble(t, freq, dur) {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, t);
      osc.frequency.exponentialRampToValueAtTime(freq * 1.9, t + dur * 0.45);
      osc.frequency.exponentialRampToValueAtTime(freq * 0.5, t + dur);
      gain.gain.setValueAtTime(0, t);
      gain.gain.linearRampToValueAtTime(0.13, t + 0.015);
      gain.gain.exponentialRampToValueAtTime(0.001, t + dur);
      osc.start(t); osc.stop(t + dur);
    }

    function swirl(t) {
      const buf = ctx.createBuffer(1, ctx.sampleRate * 0.4, ctx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
      const src = ctx.createBufferSource(); src.buffer = buf;
      const flt = ctx.createBiquadFilter(); flt.type = 'bandpass';
      flt.frequency.setValueAtTime(300, t);
      flt.frequency.exponentialRampToValueAtTime(2000, t + 0.35);
      flt.Q.value = 4;
      const gain = ctx.createGain();
      gain.gain.setValueAtTime(0.1, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.4);
      src.connect(flt); flt.connect(gain); gain.connect(ctx.destination);
      src.start(t); src.stop(t + 0.4);
    }

    swirl(0);
    bubble(0.05, 220, 0.28);
    bubble(0.18, 180, 0.32);
    bubble(0.3, 260, 0.25);
    bubble(0.42, 140, 0.3);
    swirl(0.4);
    bubble(0.55, 300, 0.22);
    bubble(0.65, 200, 0.28);
  } catch(e) {}
}

