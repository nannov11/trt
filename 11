const SEGMENTS = 24;
const SEGMENT_ANGLE = (2 * Math.PI) / SEGMENTS;

let currentAngle = 0;
let spinning = false;

const canvas = document.getElementById('wheelCanvas');
const ctx = canvas.getContext('2d');

function drawWheel(angle) {
  const cx = 280, cy = 280, r = 260;
  ctx.clearRect(0, 0, 560, 560);

  const suitCycle = ['major','wands','cups','swords','pentacles'];
  for (let i = 0; i < SEGMENTS; i++) {
    const suit = suitCycle[i % suitCycle.length];
    const color = SUIT_COLORS[suit].wheel;
    const startA = angle + i * SEGMENT_ANGLE;
    const endA = startA + SEGMENT_ANGLE;

    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.arc(cx, cy, r, startA, endA);
    ctx.closePath();

    const shade = i % 2 === 0 ? color : adjustBrightness(color, -25);
    ctx.fillStyle = shade;
    ctx.fill();
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2;
    ctx.stroke();

    const midA = startA + SEGMENT_ANGLE / 2;
    const txtR = r * 0.72;
    const tx = cx + Math.cos(midA) * txtR;
    const ty = cy + Math.sin(midA) * txtR;

    ctx.save();
    ctx.translate(tx, ty);
    ctx.rotate(midA + Math.PI / 2);
    ctx.fillStyle = '#ffffff';
    ctx.font = '500 11px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    const labels = ['Mayor','Tongkat','Cawan','Pedang','Koin'];
    ctx.fillText(labels[i % 5], 0, 0);
    ctx.restore();
  }

  ctx.beginPath();
  ctx.arc(cx, cy, 36, 0, 2 * Math.PI);
  ctx.fillStyle = '#ffffff';
  ctx.fill();
  ctx.strokeStyle = '#e0ddd8';
  ctx.lineWidth = 1;
  ctx.stroke();

  ctx.fillStyle = '#2C2C2A';
  ctx.font = '500 13px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('TAROT', cx, cy);
}

function adjustBrightness(hex, amount) {
  const num = parseInt(hex.replace('#',''), 16);
  const r = Math.min(255, Math.max(0, (num >> 16) + amount));
  const g = Math.min(255, Math.max(0, ((num >> 8) & 0xff) + amount));
  const b = Math.min(255, Math.max(0, (num & 0xff) + amount));
  return `rgb(${r},${g},${b})`;
}

drawWheel(0);

function playCauldronLoop(duration) {
  try {
    const actx = new (window.AudioContext || window.webkitAudioContext)();
    const masterGain = actx.createGain();
    masterGain.gain.setValueAtTime(1, actx.currentTime);
    masterGain.gain.setValueAtTime(1, actx.currentTime + duration - 0.4);
    masterGain.gain.linearRampToValueAtTime(0, actx.currentTime + duration);
    masterGain.connect(actx.destination);

    // Deep boiling hum — low rumble of the cauldron
    function boilHum() {
      [55, 80, 110].forEach(freq => {
        const osc = actx.createOscillator();
        const lfo = actx.createOscillator();
        const lfoGain = actx.createGain();
        const gain = actx.createGain();
        lfo.frequency.value = 0.5 + Math.random() * 1.5;
        lfoGain.gain.value = 8;
        lfo.connect(lfoGain); lfoGain.connect(osc.frequency);
        osc.connect(gain); gain.connect(masterGain);
        osc.type = 'sawtooth';
        osc.frequency.value = freq;
        gain.gain.value = 0.025;
        lfo.start(); osc.start();
        lfo.stop(actx.currentTime + duration);
        osc.stop(actx.currentTime + duration);
      });
    }

    // Continuous bubbling noise layer — filtered white noise that churns
    function bubblingNoise() {
      const bufLen = actx.sampleRate * duration;
      const buf = actx.createBuffer(1, bufLen, actx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < bufLen; i++) d[i] = Math.random() * 2 - 1;
      const src = actx.createBufferSource(); src.buffer = buf;
      const flt = actx.createBiquadFilter();
      flt.type = 'bandpass'; flt.frequency.value = 350; flt.Q.value = 1.5;
      const gain = actx.createGain(); gain.gain.value = 0.08;
      src.connect(flt); flt.connect(gain); gain.connect(masterGain);
      src.start(); src.stop(actx.currentTime + duration);
    }

    // Swirl — a sweeping bandpass that rotates like a stirring ladle
    function swirl() {
      const bufLen = actx.sampleRate * duration;
      const buf = actx.createBuffer(1, bufLen, actx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < bufLen; i++) d[i] = Math.random() * 2 - 1;
      const src = actx.createBufferSource(); src.buffer = buf;
      const flt = actx.createBiquadFilter();
      flt.type = 'bandpass'; flt.Q.value = 6;
      const gain = actx.createGain(); gain.gain.value = 0.09;
      src.connect(flt); flt.connect(gain); gain.connect(masterGain);

      // Oscillate filter freq to simulate circular stirring
      const lfo = actx.createOscillator();
      const lfoGain = actx.createGain();
      lfo.frequency.value = 1.2;
      lfoGain.gain.value = 280;
      flt.frequency.value = 500;
      lfo.connect(lfoGain); lfoGain.connect(flt.frequency);
      lfo.start(); src.start();
      lfo.stop(actx.currentTime + duration);
      src.stop(actx.currentTime + duration);
    }

    // Individual bubble pops — random timing throughout spin
    function scheduleBubbles() {
      const count = Math.floor(duration / 0.28);
      for (let i = 0; i < count; i++) {
        const t = actx.currentTime + 0.1 + Math.random() * (duration - 0.3);
        const freq = 120 + Math.random() * 220;
        const dur = 0.15 + Math.random() * 0.25;

        const osc = actx.createOscillator();
        const gain = actx.createGain();
        osc.connect(gain); gain.connect(masterGain);
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, t);
        osc.frequency.exponentialRampToValueAtTime(freq * 2.1, t + dur * 0.4);
        osc.frequency.exponentialRampToValueAtTime(freq * 0.35, t + dur);
        gain.gain.setValueAtTime(0, t);
        gain.gain.linearRampToValueAtTime(0.11, t + 0.012);
        gain.gain.exponentialRampToValueAtTime(0.001, t + dur);
        osc.start(t); osc.stop(t + dur);
      }
    }

    // Mystical shimmer — high freq sparkles that intensify mid-spin
    function mysticalShimmer() {
      const count = Math.floor(duration / 0.35);
      for (let i = 0; i < count; i++) {
        const t = actx.currentTime + 0.3 + i * (duration / count) + Math.random() * 0.2;
        const freq = 1400 + Math.random() * 2800;
        const osc = actx.createOscillator();
        const gain = actx.createGain();
        osc.connect(gain); gain.connect(masterGain);
        osc.type = 'triangle';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.04, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.18);
        osc.start(t); osc.stop(t + 0.18);
      }
    }

    boilHum();
    bubblingNoise();
    swirl();
    scheduleBubbles();
    mysticalShimmer();

    return actx;
  } catch(e) { return null; }
}

function spinWheel() {
  if (spinning) return;
  spinning = true;

  document.getElementById('spinBtn').disabled = true;
  document.getElementById('cardReveal').classList.remove('visible');

  const chosen = CARDS[Math.floor(Math.random() * CARDS.length)];

  const minSpins = 5 * 2 * Math.PI;
  const extraSpins = Math.random() * 6 * 2 * Math.PI;
  const totalRot = minSpins + extraSpins;
  const duration = 3500 + Math.random() * 1000;
  const start = performance.now();
  const startAngle = currentAngle;

  playCauldronLoop(duration / 1000);

  function easeOut(t) { return 1 - Math.pow(1 - t, 3); }

  function animate(now) {
    const elapsed = now - start;
    const progress = Math.min(elapsed / duration, 1);
    const eased = easeOut(progress);

    currentAngle = startAngle + totalRot * eased;
    drawWheel(currentAngle);

    if (progress < 1) {
      requestAnimationFrame(animate);
    } else {
      spinning = false;
      document.getElementById('spinBtn').disabled = false;
      showCard(chosen);
    }
  }

  requestAnimationFrame(animate);
}

function playMagicSound() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const notes = [523, 659, 784, 1047, 1319, 1568];
    notes.forEach((freq, i) => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, ctx.currentTime + i * 0.08);
      osc.frequency.exponentialRampToValueAtTime(freq * 1.5, ctx.currentTime + i * 0.08 + 0.15);
      gain.gain.setValueAtTime(0, ctx.currentTime + i * 0.08);
      gain.gain.linearRampToValueAtTime(0.18, ctx.currentTime + i * 0.08 + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + i * 0.08 + 0.35);
      osc.start(ctx.currentTime + i * 0.08);
      osc.stop(ctx.currentTime + i * 0.08 + 0.35);
    });
    const shimmer = ctx.createOscillator();
    const shimmerGain = ctx.createGain();
    shimmer.connect(shimmerGain);
    shimmerGain.connect(ctx.destination);
    shimmer.type = 'triangle';
    shimmer.frequency.setValueAtTime(2000, ctx.currentTime);
    shimmer.frequency.linearRampToValueAtTime(4000, ctx.currentTime + 0.8);
    shimmerGain.gain.setValueAtTime(0.06, ctx.currentTime);
    shimmerGain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.8);
    shimmer.start(ctx.currentTime);
    shimmer.stop(ctx.currentTime + 0.8);
  } catch(e) {}
}

function closeAndSpin() {
  document.getElementById('cardReveal').classList.remove('visible');
  setTimeout(() => spinWheel(), 150);
}

function showCard(card) {
  const reveal = document.getElementById('cardReveal');
  const colors = SUIT_COLORS[card.suit];

  const iconEl = document.getElementById('cardIcon');
  iconEl.style.background = colors.bg;
  iconEl.style.borderColor = colors.wheel + '44';
  iconEl.textContent = card.symbol;

  document.getElementById('cardName').textContent = card.name;

  const typeEl = document.getElementById('cardType');
  const typeClass = { major:'type-major', wands:'type-wands', cups:'type-cups', swords:'type-swords', pentacles:'type-pentacles' }[card.suit];
  typeEl.className = 'card-type ' + typeClass;
  typeEl.textContent = card.arcana;

  const suitLabel = card.suit === 'major' ? '' : ` · Suit ${card.suit.charAt(0).toUpperCase() + card.suit.slice(1)}`;
  document.getElementById('cardNumber').textContent = `Nomor ${card.number}${suitLabel}`;
  document.getElementById('cardMeaning').textContent = card.meaning;

  const kwEl = document.getElementById('cardKeywords');
  kwEl.innerHTML = card.keywords.map(k => `<span class="keyword">${k}</span>`).join('');

  document.getElementById('modalName').textContent = userName ? `Untuk ${userName}` : '';
  document.getElementById('modalMood').textContent = userMood || '';
  playMagicSound();
  reveal.classList.add('visible');
}
